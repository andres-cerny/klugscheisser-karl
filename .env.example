# Copy to .env. Every service is OFF while its key is empty.

# --- core ---
DATABASE_URL=postgresql+psycopg://localhost/klugscheisser
# docker-compose instead: postgresql+psycopg://klugscheisser:klugscheisser@localhost/klugscheisser
MCP_HOST=127.0.0.1
MCP_PORT=8000
# Shared secret for the MCP endpoint (Bearer header or ?token=). Generate: python -c 'import secrets;print(secrets.token_urlsafe(32))'
MCP_AUTH_TOKEN=
# Extra Host headers to accept, JSON list, e.g. your tunnel: ["xyz.trycloudflare.com"]
MCP_ALLOWED_HOSTS=[]

# --- Instagram ---
# Apify (apify.com > Settings > Integrations). Enables real Instagram scraping.
APIFY_TOKEN=
APIFY_INSTAGRAM_ACTOR=apify/instagram-scraper
APIFY_DAILY_COST_CAP_USD=2.0
# Meta Graph API Business Discovery: token + your own IG Business account id.
META_GRAPH_TOKEN=
META_IG_BUSINESS_USER_ID=
# Bright Data Web Scraper API: free 5000 records/month (posts + profiles); used after Graph, before Apify
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_MONTHLY_RECORD_CAP=4500
BRIGHTDATA_HISTORY_MAX_POSTS=50
# auto | hybrid | apify | graph | brightdata | fixture (auto: hybrid when two or more are set)
INSTAGRAM_SOURCE=auto

# --- Jev (TypeSafe) classifier / reranker ---
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# --- LLMs (fallback classifier, image descriptions, reranker) ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# auto | claude | gemini | fake
LLM_PROVIDER=auto
LLM_DAILY_COST_CAP_USD=2.0
# Claude prompt cache for the fixed part of each call (system prompt + output schema); false = off
LLM_PROMPT_CACHE=true

# --- optional ---
XAI_API_KEY=
FIRECRAWL_API_KEY=

# --- embeddings: fake | local (needs `uv sync --extra embed`) | gemini (GEMINI_API_KEY, 384-dim) ---
EMBEDDING_PROVIDER=fake
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- media analysis (images/reels, background; Gemini free tier) ---
# auto | gemini | claude (images only) | fake | off
MEDIA_PROVIDER=auto
MEDIA_MAX_VIDEO_SECONDS=180
MEDIA_MAX_INLINE_MB=20
# free tier: 20 requests/day per model -> fallback chain, JSON list
MEDIA_FALLBACK_MODELS=["gemini-3.5-flash", "gemini-3.1-flash-lite"]
MEDIA_DAILY_LIMIT=60
MEDIA_MIN_INTERVAL_S=6
MEDIA_STALE_HOURS=48
# longest pause after rate limits in a row (doubles from 60 s, or 30 min for claude-cli / no model left)
MEDIA_BACKOFF_MAX_S=14400

# testing only: full articles from all outlets (see docs/sources.md for their terms)
NEWS_FETCH_ALL_ARTICLES=false

# --- results collectors (all ON for the private PoC; see docs/sources.md for terms) ---
SIHF_DATA_ENABLED=true
IIHF_REALTIME_ENABLED=true
PWHL_ENABLED=true
SDHL_ENABLED=true
SIHF_LEAGUE_ID=42
SIHF_SEASON=2027
IIHF_EVENT_ID=773
IIHF_EVENT_PATH=2026/ww
IIHF_SITE_GAME_ID_OFFSET=75138
PWHL_FEED_KEY=694cfeed58c932ee
PWHL_TEAMS=["Boston Fleet","PWHL Detroit","PWHL Hamilton","New York Sirens"]
SDHL_SCHEDULE_ID=20960
# national teams: Leijonat (EHT, all venues) + sihf.ch team pages (friendlies; fallback only)
LEIJONAT_ENABLED=true
# LEIJONAT_SEASON=2027  # only to override; default: season of today's date (from August: year + 1)
LEIJONAT_LEVEL_IDS=[133]
SIHF_NT_ENABLED=true
RESULTS_LOOKBACK_DAYS=14
RESULTS_REQUEST_DELAY_S=1.0
RESULTS_MAX_DETAILS=20

# --- web search (v3 P4): Brave Search API, enrichment when our documents have gaps ---
BRAVE_API_KEY=
BRAVE_COST_PER_REQUEST_USD=0.005
BRAVE_DAILY_CAP=100
BRAVE_COUNTRY=CH
BRAVE_SEARCH_LANG=de
# JSON list; "name.*" matches every top-level domain
WEB_BLOCKED_DOMAINS=["flashscore.*","livesport.*","sofascore.com","eliteprospects.com","instagram.com","facebook.com","x.com","twitter.com","tiktok.com"]
WEB_FETCH_TIMEOUT_S=15
WEB_FETCH_MAX_BYTES=3000000
WEB_TEXT_MAX_CHARS=8000
# --- profiles (v3 P2): Wikipedia + college bio pages as raw documents ---
PROFILES_ENABLED=true
PROFILES_COLLEGE_ENABLED=true
PROFILES_MAX_AGE_DAYS=14
PROFILES_WIKIPEDIA_LANGUAGES=["de","en","fr"]
# college bio pages are cut here; Wikipedia articles are stored whole (safety limit only)
PROFILES_MAX_CHARS=6000
PROFILES_WIKIPEDIA_MAX_CHARS=100000
PROFILES_REQUEST_DELAY_S=1.0
PROFILES_MAX_CRAWL_DELAY_S=60
# Wikipedia lookup for never-seen persons in a question: background (true) or inside the request (false)
PROFILES_IN_BACKGROUND=true
# --- web app (v3 P6): pages at /, MCP stays at /mcp ---
# Cloudflare Access emails allowed in, JSON list. Empty = no check (local dev only!)
WEB_ACCESS_EMAILS=[]
# optional password login (signed cookie) when Cloudflare Access is not in front
WEB_PASSWORD=
WEB_SECRET=
WEB_SESSION_DAYS=30
# person page starts the daily Instagram update in the background
WEB_AUTO_REFRESH=true
# page views by bots / headless browsers start no paid update (true = they do, as before 2026-10-25)
WEB_REFRESH_FOR_BOTS=false
WEB_PAGE_POSTS=6
# auto (Gemini answer engine when available) | fake (no LLM, for testing)
WEB_ANSWER_ENGINE=auto

# --- v11: Elite Prospects profile pages (polite: 1 page every 6-9 s, at night, max 300/day; see docs/sources.md) ---
# EP's terms forbid scraping (private project, risk accepted by Ondřej 2026-10-04). Off in code unless set here.
EP_ENABLED=true
EP_TIER3=false
EP_DAILY_PAGE_CAP=300
EP_BLOCK_PAUSE_DAYS=7
EP_MIN_GAP_S=6
EP_MAX_GAP_S=9
EP_BACKOFF_S=[30,60,120]
EP_RETRY_AFTER_MAX_S=600
EP_FAIL_STREAK_STOP=5
EP_TIER1_EVERY_DAYS=1
EP_TIER2_EVERY_DAYS=7
EP_TIER3_EVERY_DAYS=30
EP_AFTER_GAME=true
# right after the 05:00 nightly refresh (a start at/after NIGHTLY_HOUR waits until it is done), until 09:00
EP_NIGHTLY_START_HOUR=5
EP_NIGHTLY_END_HOUR=9
# who: tiers (tier 1 daily, tier 2 weekly, after games) | event:<key> = only that event's roster players, each
# once per night (Ondřej 2026-10-25: event:wch-2026, the Women's WCh 2026 rosters; stops after the event)
EP_SCOPE=tiers

# --- nightly refresh (2026-10-11): see jobs/nightly.py, dry run: `klugscheisser nightly --dry-run` ---
NIGHTLY_HOUR=5
# tier -> every N nights (1 = every night, 7 = stable weekly rotation); add "3": 30 for tier 3
NIGHTLY_TIERS={"1": 1, "2": 7}
NIGHTLY_CAP_USD=2.0
NIGHTLY_X_FIRST_READ_TIERS=[1]
NIGHTLY_END_HOUR=8
# one-off full night (all of NIGHTLY_FULL_TIERS, X first reads, one cap for Apify + X), starts at the hour below
NIGHTLY_FULL_ONCE_DATE=
NIGHTLY_FULL_ONCE_HOUR=1
NIGHTLY_FULL_TIERS=[1,2]
NIGHTLY_FULL_CAP_USD=8.0
# Apify plan limit $19 per cycle (starts on day 4): nightly runs stop above this ledger sum
APIFY_CYCLE_CAP_USD=18.0
APIFY_CYCLE_START_DAY=4

# --- game watch (jobs/gamewatch.py, `klugscheisser gamewatch --status`): IIHF games right after the final buzzer ---
# polls only from the scheduled start until final (max GAME_WATCH_MAX_HOURS); idle otherwise
GAME_WATCH=true
GAME_WATCH_POLL_MINUTES=5
GAME_WATCH_MAX_HOURS=4
# minutes after the final: read the game sheet again (IIHF corrects scorers/assists)
GAME_WATCH_RECHECK_MINUTES=[10,30,120]
# while an event runs (games within 2 days): read its schedule this often, for new knock-out games (0 = off)
GAME_WATCH_SCHEDULE_HOURS=6
# once per game, GAME_WATCH_FOLLOWUP_DELAY_MIN after the final: news + Instagram of both teams (accounts + roster)
GAME_WATCH_FOLLOWUP=true
GAME_WATCH_FOLLOWUP_DELAY_MIN=60
GAME_WATCH_FOLLOWUP_MAX_PERSONS=30
# Apify per follow-up (always also inside APIFY_DAILY_COST_CAP_USD and APIFY_CYCLE_CAP_USD); Bright Data: own caps
GAME_WATCH_FOLLOWUP_APIFY_USD=0.30
# after every final sheet: players who dressed (scorers, assists, goalies; full line-ups when a feed has them) but are
# not on the tournament roster are added as confirmed (source: IIHF game sheet + date); nobody is removed
GAME_WATCH_SHEET_ROSTERS=true
# in the follow-up: the roster watcher (kaderwatch, free, official pages) for the two teams of the game
GAME_WATCH_ROSTER_WATCH=true
# MCP: answers wait AUTO_REFRESH_WAIT_S for the daily update; the status tools wait STATUS_WAIT_S
STATUS_WAIT_S=60
# one `mcp_call tool=… dur=… ua=… cost=… cache=… refresh=… args=…` log line per tool call
MCP_CALL_LOG=true
